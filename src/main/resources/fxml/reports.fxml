<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.attendx.controller.ReportController"
      spacing="16" styleClass="page-bg">
    <padding>
        <Insets top="20" right="24" bottom="24" left="24" />
    </padding>
    <children>
        <!-- REPORT TYPE & FILTERS BAR -->
        <VBox styleClass="card-panel" spacing="12">
            <children>
                <Label text="Reports &amp; Analytics Generator" style="-fx-font-weight: bold; -fx-font-size: 14px;" />

                <FlowPane hgap="12" vgap="12" alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="4">
                            <children>
                                <Label text="Report Category" styleClass="form-label" />
                                <ComboBox fx:id="reportTypeCombo" prefWidth="240" styleClass="form-field" />
                            </children>
                        </VBox>

                        <VBox fx:id="dateBox" spacing="4">
                            <children>
                                <Label text="Date" styleClass="form-label" />
                                <DatePicker fx:id="singleDatePicker" prefWidth="140" styleClass="form-field" />
                            </children>
                        </VBox>

                        <VBox fx:id="monthBox" spacing="4">
                            <children>
                                <Label text="Month &amp; Year" styleClass="form-label" />
                                <HBox spacing="6">
                                    <children>
                                        <ComboBox fx:id="monthCombo" prefWidth="110" styleClass="form-field" />
                                        <ComboBox fx:id="yearCombo" prefWidth="90" styleClass="form-field" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="4" alignment="BOTTOM_LEFT">
                            <children>
                                <Button fx:id="generateBtn" text="Generate Report" onAction="#handleGenerateReport" styleClass="primary-btn" style="-fx-padding: 8 20;" />
                            </children>
                        </VBox>
                    </children>
                </FlowPane>
            </children>
        </VBox>

        <!-- REPORT PREVIEW & EXPORT ACTIONS -->
        <VBox styleClass="card-panel" VBox.vgrow="ALWAYS" spacing="12">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Label fx:id="reportStatusLabel" text="No report generated yet" style="-fx-font-weight: bold; -fx-text-fill: #495057;" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="exportExcelBtn" text="📊 Export Excel (.xlsx)" onAction="#handleExportExcel" styleClass="secondary-btn" disable="true" />
                        <Button fx:id="exportPdfBtn" text="📄 Export PDF" onAction="#handleExportPdf" styleClass="secondary-btn" disable="true" />
                        <Button fx:id="exportCsvBtn" text="📝 Export CSV" onAction="#handleExportCsv" styleClass="secondary-btn" disable="true" />
                    </children>
                </HBox>

                <!-- Dynamic Table for Report Output -->
                <TableView fx:id="reportTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
