<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.attendx.controller.MainController"
            styleClass="page-bg" prefWidth="1280" prefHeight="800">
    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <padding>
                <Insets top="20" right="14" bottom="20" left="14" />
            </padding>
            <children>
                <!-- Brand -->
                <VBox spacing="2">
                    <padding>
                        <Insets left="8" bottom="14" />
                    </padding>
                    <children>
                        <Label text="AttendX" styleClass="sidebar-brand" />
                        <Label text="Smart Management" styleClass="page-subtitle" />
                    </children>
                </VBox>

                <Separator />

                <!-- Navigation Links -->
                <VBox spacing="4" fillWidth="true">
                    <children>
                        <Button fx:id="navDashboard" text="📊   Dashboard" onAction="#handleNavDashboard" styleClass="sidebar-btn, active" />
                        <Button fx:id="navStudents" text="🎓   Students" onAction="#handleNavStudents" styleClass="sidebar-btn" />
                        <Button fx:id="navFaculty" text="👨‍🏫   Faculty" onAction="#handleNavFaculty" styleClass="sidebar-btn" />
                        <Button fx:id="navAttendance" text="📋   Mark Attendance" onAction="#handleNavAttendance" styleClass="sidebar-btn" />
                        <Button fx:id="navReports" text="📈   Reports &amp; Analytics" onAction="#handleNavReports" styleClass="sidebar-btn" />
                    </children>
                </VBox>

                <!-- Spacer -->
                <Region VBox.vgrow="ALWAYS" />

                <Separator />

                <!-- User Footer & Logout -->
                <VBox spacing="8">
                    <padding>
                        <Insets left="4" right="4" top="4" bottom="4" />
                    </padding>
                    <children>
                        <VBox spacing="2">
                            <children>
                                <Label fx:id="userNameLabel" text="Administrator" style="-fx-font-weight: bold; -fx-text-fill: #212529;" />
                                <Label fx:id="userRoleBadge" text="ADMIN" styleClass="badge-admin" />
                            </children>
                        </VBox>
                        <Button fx:id="logoutBtn" text="Sign Out" onAction="#handleLogout" styleClass="danger-btn" maxWidth="Infinity" style="-fx-padding: 6 12; -fx-font-size: 12px;" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header-bar">
            <children>
                <VBox spacing="2">
                    <children>
                        <Label fx:id="pageTitleLabel" text="Dashboard Overview" styleClass="section-title" />
                        <Label fx:id="pageSubtitleLabel" text="Real-time institutional attendance analytics" styleClass="page-subtitle" />
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Current Date display -->
                <Label fx:id="currentDateLabel" text="Today" style="-fx-font-weight: 500; -fx-text-fill: #6C757D;" />

                <!-- Theme Toggle Button -->
                <ToggleButton fx:id="themeToggle" text="🌙 Dark Mode" onAction="#handleToggleTheme" styleClass="secondary-btn" />
            </children>
        </HBox>
    </top>

    <!-- CENTER CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea">
            <!-- Dynamic FXML Views Loaded Here -->
        </StackPane>
    </center>
</BorderPane>
